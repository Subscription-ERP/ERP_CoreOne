<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.rootcore.sd.mapper.InOrdMapper">

    <!-- 수주 등록 -->
    <insert id="insertInOrd" parameterType="InOrdVO">
        <selectKey keyProperty="inordNo" resultType="string" order="BEFORE">
            SELECT FN_MAKE_DATE_CODE('INORD') FROM DUAL
        </selectKey>

        INSERT INTO tb_inord (company_code,
                              inord_no,
                              inord_date,
                              due_date,
                              dept,
                              pic,
                              cust_code,
                              cust_name,
                              total_supply_price,
                              total_surtax,
                              total_price,
                              created_by,
                              create_date)
        VALUES ('0000',
                #{inordNo},
                #{inordDate},
                #{dueDate},
                #{dept},
                #{pic},
                #{custCode},
                #{custName},
                #{totalSupplyPrice},
                #{totalSurtax},
                #{totalPrice},
                '박봉근',
                SYSDATE)
    </insert>

    <!-- 수주 품목 등록 -->
    <insert id="insertInOrdDetail" parameterType="InOrdDetailVO">
        <selectKey keyProperty="inordDetailNo" resultType="string" order="BEFORE">
            SELECT FN_MAKE_DATE_CODE('INORD_DETAIL') FROM DUAL
        </selectKey>

        INSERT INTO tb_inord_detail (inord_detail_no,
                                     company_code,
                                     inord_no,
                                     sku,
                                     qty,
                                     unit_price,
                                     supply_price,
                                     surtax,
                                     price,
                                     remark,
                                     created_by,
                                     create_date)
        VALUES ( #{inordDetailNo},
                '0000',
                #{inordNo},
                #{sku},
                #{qty},
                #{unitPrice},
                #{supplyPrice},
                #{surtax},
                #{price},
                #{remark},
                '박봉근',
                SYSDATE)
    </insert>

    <!-- 수주 기본 정보 불러오기 -->
    <select id="selectInordHeaderList" resultType="InOrdVO">
        SELECT *
        FROM tb_inord
    </select>

    <!-- 수주 세부 정보 불러오기 -->

</mapper>