<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.rootcore.fi.mapper.HarpMapper">

    <!-- ===============================
         ResultMap : 수금 대상 세금계산서
         (HarpInvoiceVO)
    ================================ -->
    <resultMap id="harpInvoiceMap" type="com.rootcore.fi.vo.HarpInvoiceVO">
        <result property="companyCode"      column="COMPANY_CODE"/>
        <result property="invoiceNo"        column="INVOICE_NO"/>
        <result property="custCode"         column="CUST_CODE"/>
        <result property="custName"         column="CUST_NAME"/>

        <result property="invoiceType"      column="INVOICE_TYPE"/>
        <result property="status"           column="STATUS"/>
        <result property="issueDate"        column="ISSUE_DATE"/>
        <result property="documentDate"     column="DOCUMENT_DATE"/>

        <result property="totalSupplyPrice" column="TOTAL_SUPPLY_PRICE"/>
        <result property="totalTaxPrice"    column="TOTAL_TAX_PRICE"/>
        <result property="totalAmount"      column="TOTAL_AMOUNT"/>

        <result property="harpAmount"       column="HARP_AMOUNT"/>
        <result property="remainAmount"     column="REMAIN_AMOUNT"/>
    </resultMap>

    <!-- ===============================
         수금 대상 세금계산서 목록 조회
         - TB_INVOICE_MASTER 기준
         - TB_HARP_DETAIL 에서 기수금액 합산
         - 미수금액 > 0 인 건만 조회
    ================================ -->
    <select id="selectInvoiceTargetList"
            parameterType="com.rootcore.fi.vo.HarpInvoiceVO"
            resultMap="harpInvoiceMap">

        SELECT
            im.COMPANY_CODE,
            im.INVOICE_NO,
            im.CUST_CODE,
            cm.CUST_NAME,
            im.INVOICE_TYPE,
            im.STATUS,
            im.ISSUE_DATE,
            im.DOCUMENT_DATE,
            im.TOTAL_SUPPLY_PRICE,
            im.TOTAL_TAX_PRICE,
            im.TOTAL_AMOUNT,
            NVL(hd.HARP_AMOUNT, 0)                     AS HARP_AMOUNT,
            (im.TOTAL_AMOUNT - NVL(hd.HARP_AMOUNT, 0)) AS REMAIN_AMOUNT
        FROM TB_INVOICE_MASTER im
            JOIN TB_CUST_MASTER cm
              ON cm.COMPANY_CODE = im.COMPANY_CODE
             AND cm.CUST_CODE    = im.CUST_CODE
            LEFT JOIN (
                SELECT
                    COMPANY_CODE,
                    INVOICE_NO,
                    SUM(AMOUNT) AS HARP_AMOUNT
                FROM TB_HARP_DETAIL
                GROUP BY COMPANY_CODE, INVOICE_NO
            ) hd
              ON hd.COMPANY_CODE = im.COMPANY_CODE
             AND hd.INVOICE_NO   = im.INVOICE_NO
        WHERE im.COMPANY_CODE = #{companyCode}
          AND im.CUST_CODE    = #{custCode}
          <!-- 필요 시 상태/기간 조건을 추가하셔도 됩니다.
               예: AND im.STATUS = '1' (발행완료만) 등 -->
          AND (im.TOTAL_AMOUNT - NVL(hd.HARP_AMOUNT, 0)) > 0
        ORDER BY im.ISSUE_DATE, im.INVOICE_NO

    </select>

    <!-- ===============================
         수금번호 채번
         - HARP_NO 형식 예: H00001, H00002 ...
         - 회사 구분 없이 전체 기준으로 증가 (PK 는 COMPANY_CODE + HARP_NO 이므로 무방)
    ================================ -->
    <select id="makeHarpNo" resultType="string">
        SELECT 'H'
               || LPAD(
                    NVL(MAX(TO_NUMBER(SUBSTR(HARP_NO, 2))) + 1, 1),
                    5,
                    '0'
                  ) AS HARP_NO
          FROM TB_HARP_MASTER
    </select>

    <!-- ===============================
         TB_HARP_MASTER INSERT
    ================================ -->
    <insert id="insertHarpMaster"
            parameterType="com.rootcore.fi.vo.HarpMasterVO">

        INSERT INTO TB_HARP_MASTER (
            COMPANY_CODE,
            HARP_NO,
            CUST_CODE,
            HARP_DATE,
            TOTAL_AMOUNT,
            CREATED_BY,
            CREATE_DATE,
            UPDATED_BY,
            UPDATE_DATE
        ) VALUES (
            #{companyCode},
            #{harpNo},
            #{custCode},
            #{harpDate},
            #{totalAmount},
            NVL(#{createdBy}, 'ADMIN'),
            SYSDATE,
            NVL(#{updatedBy}, 'ADMIN'),
            SYSDATE
        )

    </insert>

    <!-- ===============================
         TB_HARP_DETAIL INSERT
    ================================ -->
    <insert id="insertHarpDetail"
            parameterType="com.rootcore.fi.vo.HarpDetailVO">

        INSERT INTO TB_HARP_DETAIL (
            HARP_DETAIL_NO,
            COMPANY_CODE,
            HARP_NO,
            INVOICE_NO,
            AMOUNT,
            CREATED_BY,
            CREATE_DATE,
            UPDATED_BY,
            UPDATE_DATE
        ) VALUES (
            #{harpDetailNo},
            #{companyCode},
            #{harpNo},
            #{invoiceNo},
            #{amount},
            NVL(#{createdBy}, 'ADMIN'),
            SYSDATE,
            NVL(#{updatedBy}, 'ADMIN'),
            SYSDATE
        )

    </insert>

</mapper>
